<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="fickle-foss">
	<schema id="giving.fickle.foss" path="/giving/fickle/foss/">
		<key name="window-width" type="i"><default>600</default></key>
		<key name="window-height" type="i"><default>800</default></key>
		<key name="window-maximized" type="b"><default>false</default></key>
		<key name="window-fullscreen" type="b"><default>false</default></key>

		<key name="donation-frequency" type="s">
			<default>"monthly"</default>
			<summary>The user's selected donation cadence</summary>
			<choices>
				<choice value='weekly'/>
				<choice value='monthly'/>
				<choice value='yearly'/>
			</choices>
		</key>

		<!-- 
			budget-amount is the amount the user is committing to donate each period (e.g. monthly) 
			budget-remaining is a regularly updated value that is the amount the user has left in their budget

			We use two different figures because the user can change the budget-remaining independent of how much they have actually donated. They might do this because their income for the month was less than they expected, for example.
			-->
		<key name="budget-amount" type="i">
			<default>500</default>
			<summary>The amount the user has committed to donate each period (in cents)</summary>
		</key>
		<key name="budget-remaining" type="i">
			<default>500</default>
			<summary>The amount the user has left in their budget (in cents)</summary>
			<description>This budget-remaining value is increased by the budget-amount value at the end of a period</description>
		</key>
	</schema>
</schemalist>
