<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="DonationDialog" parent="AdwDialog">
		<property name="title" translatable="yes">Add Donation</property>
		<!-- <property name="follows-content-size">true</property> -->
		<child>
			<object class="GtkBox">
				<property name="orientation">vertical</property>
				<property name="spacing">24</property>
				<property name="margin-top">24</property>
				<property name="margin-bottom">24</property>
				<property name="margin-start">24</property>
				<property name="margin-end">24</property>

				<child>
					<object class="GtkImage" id="app_icon">
						<property name="icon-name">application-x-executable</property>
						<property name="pixel-size">96</property>
						<property name="halign">center</property>
					</object>
				</child>

				<child>
					<object class="GtkLabel" id="app_name">
						<property name="label">[app name here]</property>
						<property name="halign">center</property>
						<style><class name="title-2"/></style>
					</object>
				</child>

				<child>
					<object class="GtkBox">
						<property name="orientation">vertical</property>
						<child>
							<object class="GtkListBox" id="listbox">
								<property name="selection-mode">none</property>
								<style>
									<class name="boxed-list"/>
								</style>
								<child>
									<object class="AdwEntryRow" id="amount_field">
										<property name="title">Amount</property>
										<property name="input-purpose">NUMBER</property>
										<child type="prefix">
											<object class="GtkLabel" id="currency_symbol">
												<property name="label">$</property>
												<style><class name="dim-label"/></style>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="AdwEntryRow" id="date_field">
										<property name="title">Date</property>
										<!-- <property name="input-purpose">FREE_FORM</property> -->
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>

				<child>
					<object class="GtkBox">
						<property name="orientation">vertical</property>
						<child>
							<object class="GtkButton" id="save_button">
								<property name="label" translatable="yes">Save</property>
								<property name="halign">fill</property>
								<!-- <property name="hexpand">true</property> -->
								<property name="margin-top">8</property>
								<style>
									<class name="pill"/>
									<class name="suggested-action"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton" id="delete_button">
								<property name="label" translatable="yes">Delete</property>
								<property name="halign">fill</property>
								<!-- <property name="hexpand">true</property> -->
								<property name="margin-top">12</property>
								<style>
									<class name="pill"/>
									<class name="destructive-action"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton" id="cancel_button">
								<property name="label" translatable="yes">Cancel</property>
								<property name="halign">fill</property>
								<!-- <property name="hexpand">true</property> -->
								<property name="margin-top">12</property>
								<style>
									<class name="pill"/>
								</style>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</template>
</interface>
