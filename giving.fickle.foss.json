{
    "id" : "giving.fickle.foss",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "master",
    "sdk" : "org.gnome.Sdk",
    "command" : "fickle-foss",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
    "--filesystem=home/.local/share/applications:ro",
    "--filesystem=home/.local/share/flatpak/exports/share/applications:ro",
    "--filesystem=/var/lib/flatpak/exports/share/applications:ro"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "fickle-foss",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "file:///home/ben/Documents/Projects/Fickle FOSS"
                }
            ]
        }
    ]
}
